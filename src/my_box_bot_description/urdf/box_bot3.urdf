<?xml version="1.0"?>
<robot name="box_bot">

    <material name="red"><color rgba="1.0 0.0 0.0 1"/></material>
    <material name="black"><color rgba="0.0 0.0 0.0 1"/></material>
    <material name="green_dark"><color rgba="0.0 0.5 0.0 1"/></material>
    <material name="orange"><color rgba="1.0 0.5 0.0 1.0"/></material>
    <material name="box_bot_blue"><color rgba="0.088656 0.428691 0.491021 1"/></material>

    <link name="base_footprint"/>

    <link name="base_link">
        <visual>
            <geometry>
                <mesh filename="package://my_box_bot_description/meshes/cute_cube.dae" scale="0.1 0.1 0.1"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <box size="0.1 0.1 0.1"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.8"/>
            <origin rpy="0 0 0" xyz="0 0 -0.02"/>
            <inertia ixx="0.001333" ixy="0" ixz="0" iyy="0.001333" iyz="0" izz="0.001333"/>
        </inertial>
    </link>

    <joint name="base_link_joint" type="fixed">
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <parent link="base_footprint" />
        <child link="base_link" />
    </joint>

    <link name="left_wheel_link">
        <visual>
            <origin xyz="0 0.005 0" rpy="0 1.5707 1.5707"/>
            <geometry>
                <cylinder length="0.01" radius="0.035"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <origin xyz="0 0.005 0" rpy="0 1.5707 1.5707"/>
            <geometry>
                <cylinder length="0.01" radius="0.035"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0.005 0" rpy="0 1.5707 1.5707"/>
            <mass value="0.05"/>
            <inertia ixx="1.5316e-05" ixy="0" ixz="0"
                    iyy="1.5316e-05" iyz="0"
                    izz="3.0625e-05"/>
        </inertial>
    </link>

    <joint name="left_wheel_joint" type="continuous">
        <origin xyz="0 0.05 -0.025" rpy="0 0 0" />
        <child link="left_wheel_link"/>
        <parent link="base_link"/>
        <axis xyz="0 1 0"/>
        <limit effort="10.0" velocity="10.0"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <gazebo reference="left_wheel_link">
        <kp>1000000.0</kp>
        <kd>10.0</kd>
        <mu1>10.0</mu1>
        <mu2>10.0</mu2>
        <fdir1>1 0 0</fdir1>
        <material>Gazebo/Green</material>
    </gazebo>

    <link name="right_wheel_link">
        <visual>
            <origin xyz="0 -0.005 0" rpy="0 1.5707 1.5707"/>
            <geometry>
                <cylinder length="0.01" radius="0.035"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <origin xyz="0 -0.005 0" rpy="0 1.5707 1.5707"/>
            <geometry>
                <cylinder length="0.01" radius="0.035"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 -0.005 0" rpy="0 1.5707 1.5707"/>
            <mass value="0.05"/>
            <inertia ixx="1.5316e-05" ixy="0" ixz="0"
                    iyy="1.5316e-05" iyz="0"
                    izz="3.0625e-05"/>
        </inertial>
    </link>

    <joint name="right_wheel_joint" type="continuous">
        <origin xyz="0 -0.05 -0.025" rpy="0 0 0" />
        <child link="right_wheel_link"/>
        <parent link="base_link"/>
        <axis xyz="0 1 0"/>
        <limit effort="10.0" velocity="10.0"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <gazebo reference="right_wheel_link">
        <kp>1000000.0</kp>
        <kd>10.0</kd>
        <mu1>10.0</mu1>
        <mu2>10.0</mu2>
        <fdir1>1 0 0</fdir1>
        <material>Gazebo/Orange</material>
    </gazebo>

    <link name="front_caster_link">
        <visual>
            <geometry><sphere radius="0.01"/></geometry>
            <material name="green_dark"/>
        </visual>
        <collision>
            <geometry><sphere radius="0.01"/></geometry>
        </collision>
        <inertial>
            <mass value="0.01"/>
            <inertia ixx="4e-07" ixy="0" ixz="0" iyy="4e-07" iyz="0" izz="4e-07"/>
        </inertial>
    </link>
    <joint name="front_caster_joint" type="fixed">
        <parent link="base_link"/>
        <child link="front_caster_link"/>
        <origin xyz="0.035 0 -0.05" rpy="0 0 0"/>
    </joint>

    <gazebo reference="front_caster_link">
        <mu1>0.01</mu1>
        <mu2>0.01</mu2>
        <material>Gazebo/Purple</material>
    </gazebo>

    <link name="back_caster_link">
        <visual>
            <geometry><sphere radius="0.01"/></geometry>
            <material name="green_dark"/>
        </visual>
        <collision>
            <geometry><sphere radius="0.01"/></geometry>
        </collision>
        <inertial>
            <mass value="0.01"/>
            <inertia ixx="4e-07" ixy="0" ixz="0"
                    iyy="4e-07" iyz="0"
                    izz="4e-07"/>
        </inertial>
    </link>

    <joint name="back_caster_joint" type="fixed">
        <origin xyz="-0.035 0 -0.05" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="back_caster_link"/>
    </joint>
    <gazebo reference="back_caster_link">
        <mu1>0.01</mu1>
        <mu2>0.01</mu2>
        <material>Gazebo/Purple</material>
    </gazebo>

    <!-- Camear Control -->
    <link name="camera_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://my_box_bot_description/meshes/sensors/realsense.dae" scale="1.0 1.0 1.0"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="-0.02 0 -0.015" rpy="0 0 0"/>
            <geometry>
                <box size="0.04 0.17 0.03"/>
            </geometry>
        </collision>
        <inertial>
    <mass value="0.1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <inertia ixx="0.00024833" ixy="0" ixz="0"
            iyy="0.00002083" iyz="0"
            izz="0.00025417"/>
</inertial>
    </link>

    <joint name="camera_link_joint" type="fixed">
        <origin xyz="0.08 0 0.06" rpy="0 -0.2 0"/>
        <parent link="base_link"/>
        <child link="camera_link"/>
    </joint>


    <!-- Laser Position Control -->
    <link name="laser_scan_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://my_box_bot_description/meshes/sensors/rplidar.dae" scale="1.0 1.0 1.0"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0.0204" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.0408" radius="0.037493"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.01"/>
            <origin xyz="0 0 0.0204" rpy="0 0 0"/>
            <inertia ixx="6.066578520833334e-06" ixy="0" ixz="0" iyy="6.072950163333333e-06" iyz="0" izz="9.365128684166666e-06"/>
        </inertial>
    </link>
    <joint name="laser_scan_link_joint" type="continuous">
        <origin rpy="0 0 0" xyz="0 0 0.05"/>
        <parent link="base_link"/>
        <child link="laser_scan_link"/>
        <axis xyz="0 0 1"/>
        <limit effort="10.0" velocity="100.0"/>
        <dynamics damping="0.01" friction="0.01"/>
    </joint>

    <!-- IMU -->
    <link name="imu_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.015 0.015 0.0025"/>
            </geometry>
            <material name="box_bot_blue"/>
        </visual>
    </link>

    <joint name="imu_joint" type="fixed">
        <origin xyz="0.037 0.037 0.051" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="imu_link"/>
    </joint>

    <gazebo>
        <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
            <ros><remapping>~/out:=joint_states</remapping></ros>
            <update_rate>30</update_rate>
            <joint_name>left_wheel_joint</joint_name>
            <joint_name>right_wheel_joint</joint_name>
            <joint_name>laser_scan_link_joint</joint_name>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so" >
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>0.11</wheel_separation>
            <wheel_diameter>0.07</wheel_diameter>
            <max_wheel_torque>1.0</max_wheel_torque>
            <max_wheel_acceleration>2.0</max_wheel_acceleration>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
        </plugin>
    </gazebo>

    <gazebo reference="camera_link">
        <sensor name="camera" type="depth">
            <visualize>true</visualize>
            <update_rate>30.0</update_rate>
            <camera name="camera">
                <horizontal_fov>1.5184</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>10.0</far>
                </clip>
            </camera>
            <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                <ros>
                    <!-- <namespace>camera</namespace> -->
                    <remapping>camera/image_raw:=color/image_raw</remapping>
                    <remapping>camera/depth/image_raw:=depth/image_rect_raw</remapping>
                    <remapping>camera/camera_info:=color/camera_info</remapping>
                    <remapping>camera/depth/camera_info:=depth/camera_info</remapping>
                    <remapping>camera/points:=depth/color/points</remapping>
                </ros>
                <camera_name>d435i</camera_name>
                <frame_name>camera_depth_optical_frame</frame_name> <hack_baseline>0.07</hack_baseline>
                <min_depth>0.1</min_depth>
                <max_depth>5.0</max_depth>
            </plugin>
        </sensor>
    </gazebo>

    <gazebo reference="laser_scan_link">
        <sensor name="lidar" type="ray">
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1.0</resolution>
                        <min_angle>0.00</min_angle>
                        <max_angle>6.28</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.12</min>
                    <max>12.0</max>
                    <resolution>0.015</resolution>
                </range>
            </ray>
            <plugin name="scan_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <remapping>~/out:=scan</remapping>
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>laser_scan_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <gazebo reference="imu_link">
        <sensor name="br_imu" type="imu">
            <always_on>true</always_on>
            <update_rate>100</update_rate>
            <imu>
                <angular_velocity>
                    <x>
                        <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>2e-4</stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>2e-4</stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>2e-4</stddev>
                        </noise>
                    </z>
                </angular_velocity>
                <linear_acceleration>
                    <x>
                        <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>1.7e-2</stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>1.7e-2</stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>1.7e-2</stddev>
                        </noise>
                    </z>
                </linear_acceleration>
            </imu>
            <plugin name="bytes_imu" filename="libgazebo_ros_imu_sensor.so">
                <ros>
                    <namespace>imu</namespace>
                    <remapping>~/out:=data</remapping>
                </ros>
                <initial_orientation_as_reference>false</initial_orientation_as_reference>
            </plugin>
        </sensor>
    </gazebo>
</robot>